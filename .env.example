# Единственный источник правды для паролей и общих настроек.
# Скопируйте в .env: cp .env.example .env
# Эти же значения читает слой БД (app/db), поэтому пароли менять только здесь.

APP_NAME=alfa_llm
APP_ENV=local
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
REQUEST_ID_HEADER=X-Request-ID

VIEWER_PASSWORD=viewer-demo
ADMIN_PASSWORD=admin-demo

# Дневной лимит токенов и бюджет. Уточнить у организаторов; пусто = не задан.
DAILY_TOKEN_LIMIT_TOKENS=
BUDGET_RUB=
